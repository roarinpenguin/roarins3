# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# RoarinS3 API Configuration
ROARINS3_SECRET_KEY=change-this-in-production
ROARINS3_MINIO_ENDPOINT=localhost:9000
ROARINS3_DATABASE_URL=sqlite+aiosqlite:////data/db/roarins3.db

# Optional: Log retention
ROARINS3_LOG_RETENTION_DAYS=90
